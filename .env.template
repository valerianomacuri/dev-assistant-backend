# DevAssistant API (NestJS) - Variables de entorno
# Copia este archivo como .env y agrega tus valores reales
# NUNCA commitees el archivo .env

# === Servidor ===
PORT=3000
# Orígenes permitidos para CORS HTTP y WebSocket (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# === API Keys ===
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo de Anthropic (opciones: claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo de embeddings de OpenAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Persistencia ===
# Conexión a Postgres + pgvector (ver docker-compose.yml)
DATABASE_URL=postgresql://devassistant:devassistant@localhost:5432/devassistant
# Número de chunks a recuperar por búsqueda RAG
RAG_TOP_K=5

# === Autenticación (JWT) ===
# Usa un secreto largo y aleatorio en producción
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# === Almacenamiento de archivos (AWS S3) ===
# Deja S3_ENDPOINT vacío para AWS S3 (la SDK resuelve el endpoint). Defínelo
# solo si apuntas a un endpoint S3-compatible.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=dev-assistant-test
# Credenciales: deja vacío para usar el rol IAM / cadena por defecto del SDK.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# false en AWS S3 real (virtual-hosted style).
S3_FORCE_PATH_STYLE=false

# === AWS (SQS + Lambda) ===
AWS_REGION=us-east-1
# Deja AWS_ENDPOINT vacío para AWS real.
AWS_ENDPOINT=
# Credenciales: deja vacío para usar el rol IAM / cadena por defecto del SDK.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cola de la ingesta asíncrona de documentos (extracción → troceado → embeddings).
# Créala con `pnpm aws:setup`.
SQS_INGEST_QUEUE=dev-assistant-jobs-doc-ingest
# Nombre de la Lambda (Python + WeasyPrint) que genera el PDF del reporte.
# Vive en el repo dev-assistant-stats-lambda; debe coincidir con su deploy.
LAMBDA_STATS_REPORT=dev-assistant-worker-stats-report

# Tamaño máximo de archivo subido (MB)
MAX_UPLOAD_MB=20
