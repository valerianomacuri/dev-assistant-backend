# DevAssistant API (NestJS) - Variables de entorno
# Copia este archivo como .env y agrega tus valores reales
# NUNCA commitees el archivo .env

# === Servidor ===
PORT=3000
# Orígenes permitidos para CORS (separados por coma). Por defecto: http://localhost:5173
CORS_ORIGINS=http://localhost:5174

# === API Keys ===
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo de Anthropic (opciones: claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo de embeddings de OpenAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Persistencia ===
# Conexión a Postgres + pgvector (ver docker-compose.yml)
DATABASE_URL=postgresql://devassistant:devassistant@localhost:5432/devassistant
# Número de chunks a recuperar por búsqueda RAG
RAG_TOP_K=5

# === Autenticación (JWT) ===
# Usa un secreto largo y aleatorio en producción
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# === Almacenamiento de archivos (S3 / MinIO) ===
# Para MinIO local (ver docker-compose.yml). En AWS real, apunta a tu endpoint/región.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dev-assistant
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true para MinIO (path-style). En AWS S3 real, false.
S3_FORCE_PATH_STYLE=true

# Tamaño máximo de archivo subido (MB)
MAX_UPLOAD_MB=20
